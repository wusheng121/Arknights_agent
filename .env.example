# ---- DeepSeek(大脑)----
# 申请: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ---- 云 VLM(视觉理解,任选一家,openai 兼容)----
# 通义千问-VL(推荐,国内快): base=https://dashscope.aliyuncs.com/compatible-mode/v1, model=qwen-vl-max
# GPT-4o:                base 留空(默认 openai 官方),            model=gpt-4o
# Gemini(openai 兼容):   base=https://generativelanguage.googleapis.com/v1beta/openai, model=gemini-2.5-flash
VLM_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen-vl-max

# ---- MAA(手脚)----
# MAA dll + resource 目录(从 maa.plus 下载解压后的根目录,含 MaaCore.dll 与 resource/)
MAA_RESOURCE_PATH=
MAA_ADB_PATH=adb.exe
MAA_ADDRESS=127.0.0.1:5555
